{
  "name": "fracture-bulletheart-cryptfire",
  "private": false,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/fetch-source-assets.mjs && vite --host 0.0.0.0",
    "build": "node scripts/fetch-source-assets.mjs && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src/tests",
    "lint": "eslint .",
    "format": "prettier --write .",
    "generate:assets": "bun scripts/create-runtime-assets.mjs",
    "validate:assets": "bun src/assets/validate-manifest.ts",
    "assets": "node scripts/fetch-source-assets.mjs",
    "test:browser": "playwright test -c playwright.fracture.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.3",
    "@types/three": "^0.184.1",
    "eslint": "^9.29.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.1",
    "vite": "^7.0.0",
    "vitest": "^3.2.4",
    "pngjs": "^7.0.0",
    "@types/pngjs": "^6.0.5"
  },
  "dependencies": {
    "three": "^0.184.0"
  }
}
